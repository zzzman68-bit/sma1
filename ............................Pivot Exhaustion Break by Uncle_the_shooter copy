//@version=6
indicator('Pivot Exhaustion Break', overlay = true, max_labels_count = 500, max_lines_count = 500)

// PIVOT DETECTION
leftBars      = input.int(7,  'Left Bars for Pivot',      minval = 1, group="PIVOT DETECTION")
rightBars     = input.int(7,  'Right Bars for Pivot',     minval = 1, group="PIVOT DETECTION")
lastSequences = input.int(200,'Number of Last Sequences', minval = 1, group="PIVOT DETECTION")

//  OPTIONAL FILTER 
minSequenceForSignal = input.int(2, "Minimum Pivot Sequence for Signal", 
     minval = 1, 
     tooltip = "1 = no filter (original behavior)\n3 = Do NOT show any signals until sequence #3 appears\nShows ALL breaks from sequence 3 and higher (respects showBreak3+, showBreak9plus etc.)",
     group="BREAKOUT SIGNALS")

// SUPPORT/RESISTANCE LINES
maxLineBarsForSignal = input.int(0, "Max line length (bars) for signal", minval = 0, 
     tooltip = "0 = no limit (all breaks will generate signals)",
     group="SUPPORT/RESISTANCE LINES")

deleteBroken = input.bool(false, "Delete broken lines", group="SUPPORT/RESISTANCE LINES")

// BREAKOUT SIGNALS
showBreak1      = input.bool(true, "Breakout Signal #1",           group="BREAKOUT SIGNALS")
showBreak2      = input.bool(true,  "Breakout Signal #2",           group="BREAKOUT SIGNALS")
showBreak3      = input.bool(true,  "Breakout Signal #3",           group="BREAKOUT SIGNALS")
showBreak4      = input.bool(true,  "Breakout Signal #4",           group="BREAKOUT SIGNALS")
showBreak5      = input.bool(true, "Breakout Signal #5",           group="BREAKOUT SIGNALS")
showBreak6      = input.bool(true, "Breakout Signal #6",           group="BREAKOUT SIGNALS")
showBreak7      = input.bool(true, "Breakout Signal #7",           group="BREAKOUT SIGNALS")
showBreak8      = input.bool(true, "Breakout Signal #8",           group="BREAKOUT SIGNALS")
showBreak9plus  = input.bool(true, "Breakout Signal 9 and more",   group="BREAKOUT SIGNALS")


// STATISTICS TABLE
showTable      = input.bool(true,  "Show Statistics Table", group="STATISTICS TABLE")
tablePosition  = input.string("Top Right", "Table Position", 
     options = ["Top Left", "Top Right", "Bottom Left", "Bottom Right", "Top Center", "Bottom Center", "Middle Left", "Middle Right"],
     group="STATISTICS TABLE")
tableTextSize  = input.string("Normal", "Text Size", 
     options = ["Tiny", "Small", "Normal", "Large"], 
     group="STATISTICS TABLE")
dateFormat     = input.bool(true, "Date Format DD.MM.YYYY", group="STATISTICS TABLE")

// COLORS
supportLineColor    = input.color(color.new(color.green, 15), "Support Line Color (lows)",     group="COLORS")
resistanceLineColor = input.color(color.new(color.red,   15), "Resistance Line Color (highs)",     group="COLORS")
supportLabelColor   = input.color(color.rgb(56, 160, 59),     "Support Label Background Color",      group="COLORS")
resistanceLabelColor= input.color(color.rgb(216, 33, 33),     "Resistance Label Background Color",         group="COLORS")
bullSignalColor     = input.color(color.green,                "Bullish Breakout Signal Color",  group="COLORS")
bearSignalColor     = input.color(color.red,                  "Bearish Breakout Signal Color", group="COLORS")

// TABLE SETTINGS CONVERSION
finalTablePos = 
     tablePosition == "Top Left"      ? position.top_left :
     tablePosition == "Top Right"     ? position.top_right :
     tablePosition == "Bottom Left"   ? position.bottom_left :
     tablePosition == "Bottom Right"  ? position.bottom_right :
     tablePosition == "Top Center"    ? position.top_center :
     tablePosition == "Bottom Center" ? position.bottom_center :
     tablePosition == "Middle Left"   ? position.middle_left :
     tablePosition == "Middle Right"  ? position.middle_right : position.top_right

tableSize = 
     tableTextSize == "Tiny"   ? size.tiny :
     tableTextSize == "Small"  ? size.small :
     tableTextSize == "Large"  ? size.large : size.normal

// DATE FORMAT IN UTC
f_dateText(int t) =>
    datePart = dateFormat ? 
         str.tostring(dayofmonth(t, "UTC"), "00") + "." + str.tostring(month(t, "UTC"), "00") + "." + str.tostring(year(t, "UTC")) : 
         str.tostring(month(t, "UTC"), "00") + "/" + str.tostring(dayofmonth(t, "UTC"), "00") + "/" + str.tostring(year(t, "UTC"))
    timePart = timeframe.isintraday ? 
               (timeframe.multiplier >= 60 ? 
                  " " + str.tostring(hour(t, "UTC"), "00") + ":00" : 
                  " " + str.tostring(hour(t, "UTC"), "00") + ":" + str.tostring(minute(t, "UTC"), "00")) : 
               ""
    datePart + timePart

// PIVOT DETECTION
pHigh = ta.pivothigh(high, leftBars, rightBars)
pLow = ta.pivotlow(low, leftBars, rightBars)

// ORIGINAL VARIABLES
var int upPivotCount = 0
var float lastPLow = na
var int downPivotCount = 0
var float lastPHigh = na
var int current_low_start_time = na
var int current_high_start_time = na

// STATISTICS
var array<int> seq_lengths = array.new<int>()
var array<int> seq_start_times = array.new<int>()
var array<int> freq = array.new<int>()
var int total_pivots = 0
var int max_len = 0
var int oldest_time = na

// SUPPORT/RESISTANCE SYSTEM
var array<line> pivotLines = array.new<line>()
var array<float> pivotLevels = array.new<float>()
var array<int> pivotNumbers = array.new<int>()
var array<bool> isSupport = array.new<bool>()
var array<bool> lineActive = array.new<bool>()
var array<int> pivotStartBars = array.new<int>()
var array<int> pivotStartTimes = array.new<int>()
var array<int> toRemove = array.new<int>()

// LOWS LOGIC
if not na(pLow)
    int prev_up = upPivotCount
    if na(lastPLow) or pLow > lastPLow
        upPivotCount := upPivotCount + 1
    else
        if not na(lastPLow)
            if prev_up > max_len
                max_len := prev_up
            while array.size(freq) <= prev_up
                array.push(freq, 0)
            array.set(freq, prev_up, array.get(freq, prev_up) + 1)
            array.push(seq_lengths, prev_up)
            array.push(seq_start_times, current_low_start_time)
            total_pivots += prev_up
            while array.size(seq_lengths) > lastSequences and array.size(seq_lengths) > 0
                int removed = array.shift(seq_lengths)
                array.shift(seq_start_times)
                array.set(freq, removed, array.get(freq, removed) - 1)
                total_pivots -= removed
        upPivotCount := 1
 
    lastPLow := pLow
   
    int startBar = bar_index - rightBars
    int startTime = time[rightBars]
    line newLine = line.new(startBar, pLow, startBar + 1, pLow, extend=extend.right, color=supportLineColor, width=1)
    array.push(pivotLines, newLine)
    array.push(pivotLevels, pLow)
    array.push(pivotNumbers, upPivotCount)
    array.push(isSupport, true)
    array.push(lineActive, true)
    array.push(pivotStartBars, startBar)
    array.push(pivotStartTimes, startTime)
   
    label.new(startBar, pLow, str.tostring(upPivotCount), yloc=yloc.belowbar, color=supportLabelColor, style=label.style_label_up, textcolor=color.white, size=size.small)
    if upPivotCount == 1
        current_low_start_time := startTime

// HIGHS LOGIC
if not na(pHigh)
    int prev_down = downPivotCount
    if na(lastPHigh) or pHigh < lastPHigh
        downPivotCount := downPivotCount + 1
    else
        if not na(lastPHigh)
            if prev_down > max_len
                max_len := prev_down
            while array.size(freq) <= prev_down
                array.push(freq, 0)
            array.set(freq, prev_down, array.get(freq, prev_down) + 1)
            array.push(seq_lengths, prev_down)
            array.push(seq_start_times, current_high_start_time)
            total_pivots += prev_down
            while array.size(seq_lengths) > lastSequences and array.size(seq_lengths) > 0
                int removed = array.shift(seq_lengths)
                array.shift(seq_start_times)
                array.set(freq, removed, array.get(freq, removed) - 1)
                total_pivots -= removed
        downPivotCount := 1
 
    lastPHigh := pHigh
   
    int startBar = bar_index - rightBars
    int startTime = time[rightBars]
    line newLine = line.new(startBar, pHigh, startBar + 1, pHigh, extend=extend.right, color=resistanceLineColor, width=1)
    array.push(pivotLines, newLine)
    array.push(pivotLevels, pHigh)
    array.push(pivotNumbers, downPivotCount)
    array.push(isSupport, false)
    array.push(lineActive, true)
    array.push(pivotStartBars, startBar)
    array.push(pivotStartTimes, startTime)
   
    label.new(startBar, pHigh, str.tostring(downPivotCount), yloc=yloc.abovebar, color=resistanceLabelColor, style=label.style_label_down, textcolor=color.white, size=size.small)
    if downPivotCount == 1
        current_high_start_time := startTime

// OLDEST PIVOT
oldest_time := na
if array.size(seq_start_times) > 0
    oldest_time := array.get(seq_start_times, 0)
if not na(current_low_start_time) and (na(oldest_time) or current_low_start_time < oldest_time)
    oldest_time := current_low_start_time
if not na(current_high_start_time) and (na(oldest_time) or current_high_start_time < oldest_time)
    oldest_time := current_high_start_time

// STATISTICS TABLE
array<int> temp_freq = array.copy(freq)
int temp_max_len = max_len
if upPivotCount >= 1
    if upPivotCount > temp_max_len
        temp_max_len := upPivotCount
    while array.size(temp_freq) <= upPivotCount
        array.push(temp_freq, 0)
    array.set(temp_freq, upPivotCount, array.get(temp_freq, upPivotCount) + 1)
if downPivotCount >= 1
    if downPivotCount > temp_max_len
        temp_max_len := downPivotCount
    while array.size(temp_freq) <= downPivotCount
        array.push(temp_freq, 0)
    array.set(temp_freq, downPivotCount, array.get(temp_freq, downPivotCount) + 1)
int num_seq = 0
int temp_total_streaks = 0
for i = 1 to temp_max_len
    if array.size(temp_freq) > i and array.get(temp_freq, i) > 0
        num_seq += 1
        temp_total_streaks += array.get(temp_freq, i)

var table freq_table = na

if not na(freq_table)
    table.delete(freq_table)
    freq_table := na

if showTable
    int extra_row = na(oldest_time) ? 0 : 1
    int table_rows = num_seq + 2 + extra_row
    freq_table := table.new(finalTablePos, columns = 2, rows = table_rows, border_width = 1, frame_width = 1, bgcolor = color.new(color.gray, 50), border_color = color.white, frame_color = color.white)

    table.cell(freq_table, 0, 0, "Seq Len", bgcolor = color.new(color.black, 30), text_color = color.white, text_size = tableSize)
    table.cell(freq_table, 1, 0, "Count", bgcolor = color.new(color.black, 30), text_color = color.white, text_size = tableSize)

    int row = 1
    for i = 1 to temp_max_len
        if array.size(temp_freq) > i and array.get(temp_freq, i) > 0
            table.cell(freq_table, 0, row, str.tostring(i), text_color = color.white, bgcolor = color.new(color.gray, 80), text_size = tableSize)
            table.cell(freq_table, 1, row, str.tostring(array.get(temp_freq, i)), text_color = color.white, bgcolor = color.new(color.gray, 80), text_size = tableSize)
            row += 1

    table.cell(freq_table, 0, row, "TOTAL", bgcolor = color.new(color.black, 50), text_color = color.white, text_size = tableSize)
    table.cell(freq_table, 1, row, str.tostring(temp_total_streaks), bgcolor = color.new(color.black, 40), text_color = color.white, text_size = tableSize)
    row += 1

    if not na(oldest_time)
        string dateText = f_dateText(oldest_time)
        table.cell(freq_table, 0, row, "From: " + dateText + " (UTC)", bgcolor = color.new(color.black, 40), text_color = color.white, text_size = tableSize)
        table.merge_cells(freq_table, 0, row, 1, row)

// BREAKOUT DETECTION + FILTER
bool bullBreakSignal = false
bool bearBreakSignal = false
array.clear(toRemove)
if array.size(pivotLines) > 0
    for i = 0 to array.size(pivotLines) - 1
        if array.get(lineActive, i)
            line l = array.get(pivotLines, i)
            float lvl = array.get(pivotLevels, i)
            int num = array.get(pivotNumbers, i)
            bool supp = array.get(isSupport, i)
           
            bool broken = supp ? close < lvl : close > lvl
           
            if broken
                line.set_extend(l, extend.none)
                line.set_x2(l, bar_index)
                array.set(lineActive, i, false)
               
                int lineStartBar = array.get(pivotStartBars, i)
                int lineLengthBars = bar_index - lineStartBar
                bool lineTooLong = maxLineBarsForSignal > 0 and lineLengthBars > maxLineBarsForSignal
               
                if deleteBroken
                    line.delete(l)
                    array.push(toRemove, i)
               
                bool showThis = false
                if not lineTooLong and num >= minSequenceForSignal
                    if num >= 9
                        showThis := showBreak9plus
                    else
                        switch num
                            1 => showThis := showBreak1
                            2 => showThis := showBreak2
                            3 => showThis := showBreak3
                            4 => showThis := showBreak4
                            5 => showThis := showBreak5
                            6 => showThis := showBreak6
                            7 => showThis := showBreak7
                            8 => showThis := showBreak8
               
                if showThis
                    if supp
                        bearBreakSignal := true
                    else
                        bullBreakSignal := true

// CLEANUP
if array.size(toRemove) > 0
    array.sort(toRemove, order.descending)
    for i = 0 to array.size(toRemove) - 1
        int idx = array.get(toRemove, i)
        array.remove(pivotLines, idx)
        array.remove(pivotLevels, idx)
        array.remove(pivotNumbers, idx)
        array.remove(isSupport, idx)
        array.remove(lineActive, idx)
        array.remove(pivotStartBars, idx)
        array.remove(pivotStartTimes, idx)

// SIGNALS
plotshape(bullBreakSignal, "Bull Pivot Break", shape.triangleup, location.belowbar, bullSignalColor, size=size.small)
plotshape(bearBreakSignal, "Bear Pivot Break", shape.triangledown, location.abovebar, bearSignalColor, size=size.small)

// ALERT CONDITIONS
alertcondition(bullBreakSignal, 
     title = "Bullish Pivot Break",  
     message = "Bullish Pivot Exhaustion Break\nTicker: {{ticker}} | Timeframe: {{interval}} | Price: {{close}}")

alertcondition(bearBreakSignal, 
     title = "Bearish Pivot Break",  
     message = "Bearish Pivot Exhaustion Break\nTicker: {{ticker}} | Timeframe: {{interval}} | Price: {{close}}")