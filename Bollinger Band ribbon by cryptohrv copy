// Bollinger Bands Function
bollingerBands(src, length, mult, devMult) =>
    basis = ta.sma(src, length)
    dev = mult * ta.stdev(src, length)
    upper = basis + (devMult * dev)
    lower = basis - (devMult * dev)
    [upper, lower]

