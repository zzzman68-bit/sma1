//@version=4
//EDF -- BB%B plus ATR -- Trade Entry -- Profit Target
study(title = "Bollinger Bands %B", shorttitle = "BB %B", format=format.price, precision=4)
length = input(20, minval=1)
src = input(close, title="Source")
mult = input(2.0, minval=0.001, maxval=50)
basis = sma(src, length)
dev = mult * stdev(src, length)
upper = basis + dev
lower = basis - dev
bbr = (src - lower)/(upper - lower)
plot(bbr, color=color.teal)
band1 = hline(1, color=color.gray, linestyle=hline.style_dashed)
band0 = hline(0, color=color.gray, linestyle=hline.style_dashed)
band2 = hline(0.50, color=color.blue, linestyle=hline.style_solid)
fill(band1, band0, color=color.teal, transp=88)

length1 = input(title="Length", defval=14, minval=1)
smoothing = input(title="Smoothing", defval="RMA", options=["RMA", "SMA", "EMA", "WMA"])

ma_function(source, length) => 
    if smoothing == "RMA"
        rma(source, length)
    else
        if smoothing == "SMA"
            sma(source, length)
        else
            if smoothing == "EMA"
                ema(source, length)
            else
                wma(source, length)

plot(ma_function(tr(true), length), title = "ATR", color=#991515, transp=0)